<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical">

    <!-- ===== Premium App Bar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_sm">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="?colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/cleanup_title"
            android:textColor="?colorOnSurface"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold" />

        <!-- Sağ boşluk (simetri için) -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <!-- ===== İçerik Alanı ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ====== Görsel Seçme - Dropzone ====== -->
        <LinearLayout
            android:id="@+id/layout_select_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Dropzone Kartı -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@drawable/bg_dropzone"
                android:clickable="true"
                android:focusable="true"
                android:id="@+id/btn_select_image">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Upload İkon -->
                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_icon_upload">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_upload"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/no_image_selected"
                        android:textColor="@color/text_secondary_light"
                        android:textSize="@dimen/text_body"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/dropzone_formats_basic"
                        android:textColor="@color/text_tertiary_light"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </FrameLayout>

            <!-- Alt Buton -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_image_alt"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/select_from_gallery"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body"
                app:cornerRadius="@dimen/button_corner_radius_pill"
                app:icon="@android:drawable/ic_menu_gallery"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- ====== Maske Çizim Alanı ====== -->
        <LinearLayout
            android:id="@+id/layout_draw_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- MaskDrawingView -->
            <com.example.myapplication.view.MaskDrawingView
                android:id="@+id/mask_drawing_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Alt kontrol çubuğu -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?colorSurface"
                app:cardCornerRadius="0dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_sm">

                    <!-- Mod Toggle + Undo/Clear -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_sm">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_mode_toggle"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="@string/cleanup_mode_draw"
                            android:textAllCaps="false"
                            android:textSize="@dimen/text_caption"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/primary" />

                        <View
                            android:layout_width="@dimen/spacing_sm"
                            android:layout_height="0dp" />

                        <ImageButton
                            android:id="@+id/btn_undo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:contentDescription="@string/cleanup_undo"
                            android:src="@android:drawable/ic_menu_revert"
                            app:tint="?colorOnSurface" />

                        <ImageButton
                            android:id="@+id/btn_clear"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:background="?selectableItemBackgroundBorderless"
                            android:contentDescription="@string/cleanup_clear"
                            android:src="@android:drawable/ic_menu_delete"
                            app:tint="@color/error" />
                    </LinearLayout>

                    <!-- Fırça boyutu -->
                    <LinearLayout
                        android:id="@+id/layout_brush_controls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingTop="@dimen/spacing_xs">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cleanup_brush_size"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="@dimen/text_caption" />

                        <SeekBar
                            android:id="@+id/seekbar_brush_size"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="@dimen/spacing_sm"
                            android:max="90"
                            android:progress="30"
                            android:progressTint="@color/primary"
                            android:thumbTint="@color/primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ====== Sonuç (Before/After Slider) ====== -->
        <LinearLayout
            android:id="@+id/layout_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <com.example.myapplication.view.BeforeAfterSliderView
                android:id="@+id/before_after_slider"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- ====== Premium Loading Overlay ====== -->
        <FrameLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/overlay_dark"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:cardBackgroundColor="?colorSurface"
                app:cardCornerRadius="@dimen/loading_card_corner"
                app:cardElevation="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/loading_card_padding">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminate="true"
                        app:indicatorColor="@color/primary"
                        app:indicatorSize="48dp"
                        app:trackColor="@color/primary_surface"
                        app:trackThickness="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/loading_ai_working"
                        android:textColor="?colorOnSurface"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/loading_cleanup"
                        android:textColor="@color/text_secondary_light"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </FrameLayout>

    <!-- ===== Alt Butonlar ===== -->
    <LinearLayout
        android:id="@+id/layout_bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_process"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="@string/cleanup_process"
            android:textAllCaps="false"
            android:textSize="@dimen/text_body"
            app:cornerRadius="@dimen/button_corner_radius_pill"
            app:icon="@android:drawable/ic_menu_send"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="@string/save_image"
            android:textAllCaps="false"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            app:cornerRadius="@dimen/button_corner_radius_pill"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:strokeColor="@color/primary" />
    </LinearLayout>

</LinearLayout>

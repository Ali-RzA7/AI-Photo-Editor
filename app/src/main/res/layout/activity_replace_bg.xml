<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical">

    <!-- ===== Premium App Bar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_sm">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="?colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/replacebg_title"
            android:textColor="?colorOnSurface"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <!-- ===== İçerik Alanı ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ====== Görsel Seçme - Dropzone ====== -->
        <ScrollView
            android:id="@+id/layout_select_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <FrameLayout
                    android:id="@+id/btn_select_image"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:background="@drawable/bg_dropzone"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_icon_upload">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_upload"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:gravity="center"
                            android:text="@string/dropzone_upload_replacebg"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="@dimen/text_body" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/dropzone_formats_max_2048"
                            android:textColor="@color/text_tertiary_light"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_select_image_alt"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/select_from_gallery"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_body"
                    app:cornerRadius="@dimen/button_corner_radius_pill"
                    app:icon="@android:drawable/ic_menu_gallery"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </ScrollView>

        <!-- ====== Ön İzleme + Prompt ====== -->
        <ScrollView
            android:id="@+id/layout_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <!-- Seçilen görsel -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    app:cardBackgroundColor="?colorSurface"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation">

                    <ImageView
                        android:id="@+id/img_original"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/label_original_image"
                    android:textColor="@color/text_tertiary_light"
                    android:textSize="@dimen/text_caption" />

                <!-- Prompt Giriş Alanı -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_prompt"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/primary"
                    app:startIconDrawable="@android:drawable/ic_menu_edit"
                    app:startIconTint="@color/primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/replacebg_prompt_hint"
                        android:inputType="textMultiLine"
                        android:maxLines="3"
                        android:minLines="2"
                        android:textSize="@dimen/text_body" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Örnek prompt'lar -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:cardBackgroundColor="@color/primary_surface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡 Örnek prompt'lar:"
                            android:textColor="@color/primary_dark"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/prompt_examples_body"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Üret butonu -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_process"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/replacebg_process"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_body"
                    app:cornerRadius="@dimen/button_corner_radius_pill"
                    app:icon="@android:drawable/ic_menu_send"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </ScrollView>

        <!-- ====== Sonuç (Before/After Slider) ====== -->
        <LinearLayout
            android:id="@+id/layout_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?colorSurface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <com.example.myapplication.view.BeforeAfterSliderView
                    android:id="@+id/before_after_slider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/success_replacebg"
                android:textColor="@color/accent_green"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ====== Premium Loading Overlay ====== -->
        <FrameLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/overlay_dark"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:cardBackgroundColor="?colorSurface"
                app:cardCornerRadius="@dimen/loading_card_corner"
                app:cardElevation="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/loading_card_padding">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminate="true"
                        app:indicatorColor="@color/primary"
                        app:indicatorSize="48dp"
                        app:trackColor="@color/primary_surface"
                        app:trackThickness="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/loading_ai_working"
                        android:textColor="?colorOnSurface"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/loading_replacebg"
                        android:textColor="@color/text_secondary_light"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </FrameLayout>

    <!-- ===== Alt Kaydet Butonu ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?colorSurface"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="@string/save_image"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body"
                android:visibility="gone"
                app:backgroundTint="@color/accent_green"
                app:cornerRadius="@dimen/button_corner_radius_pill"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="textStart" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
